     "varying vec2 texCoord;                                             \n"
     "uniform sampler2D texSampler;                                      \n"
     "uniform float rbSwap;                                              \n"
+    "uniform float gammaPow;   // 1.0 = off, else SGI 2.4 -> modern 2.2 \n"
+    "uniform bool ditherOn;                                             \n"
+    "uniform vec3 ditherLvls;  // quantization levels per channel       \n"
+    "uniform vec2 fbRes;       // fb pixel resolution (Bayer grid)      \n"
+    "                                                                   \n"
+    "// Authentic REX3 4x4 Bayer matrix (issue #9)                      \n"
+    "float bayer4x4(vec2 pos)                                           \n"
+    "{                                                                  \n"
+    "    vec2 p = floor(mod(pos, 4.0));                                 \n"
+    "    float idx = p.x + p.y * 4.0;                                   \n"
+    "    float m;                                                       \n"
+    "    if      (idx <  0.5) m =  0.0;                                 \n"
+    "    else if (idx <  1.5) m =  8.0;                                 \n"
+    "    else if (idx <  2.5) m =  2.0;                                 \n"
+    "    else if (idx <  3.5) m = 10.0;                                 \n"
+    "    else if (idx <  4.5) m = 12.0;                                 \n"
+    "    else if (idx <  5.5) m =  4.0;                                 \n"
+    "    else if (idx <  6.5) m = 14.0;                                 \n"
+    "    else if (idx <  7.5) m =  6.0;                                 \n"
+    "    else if (idx <  8.5) m =  3.0;                                 \n"
+    "    else if (idx <  9.5) m = 11.0;                                 \n"
+    "    else if (idx < 10.5) m =  1.0;                                 \n"
+    "    else if (idx < 11.5) m =  9.0;                                 \n"
+    "    else if (idx < 12.5) m = 15.0;                                 \n"
+    "    else if (idx < 13.5) m =  7.0;                                 \n"
+    "    else if (idx < 14.5) m = 13.0;                                 \n"
+    "    else                 m =  5.0;                                 \n"
+    "    return (m + 0.5) / 16.0;                                       \n"
+    "}                                                                  \n"
+    "                                                                   \n"
+    "float ditherChannel(float c, float lvl, float threshold)           \n"
+    "{                                                                  \n"
+    "    float maxVal = lvl - 1.0;                                      \n"
+    "    float scaled = c * maxVal;                                     \n"
+    "    float lo = floor(scaled);                                      \n"
+    "    float frac = scaled - lo;                                      \n"
+    "    float quantized = lo + step(threshold, frac);                  \n"
+    "    return clamp(quantized / maxVal, 0.0, 1.0);                    \n"
+    "}                                                                  \n"
+    "                                                                   \n"
     "void main()                                                        \n"
     "{                                                                  \n"
     "    // CPU-uploaded textures hold BGRA bytes: swap B and R.        \n"
     "    // FBO textures (gles2 rasterizer) are true RGBA: no swap.     \n"
     "    vec3 texel = texture2D(texSampler, texCoord).rgb;              \n"
-    "    gl_FragColor = vec4(mix(texel, texel.bgr, rbSwap), 1.0);       \n"
+    "    vec3 c = mix(texel, texel.bgr, rbSwap);                        \n"
+    "                                                                   \n"
+    "    // REX3 hardware dither at the selected bit depth              \n"
+    "    if (ditherOn)                                                  \n"
+    "    {                                                              \n"
+    "        float t = bayer4x4(texCoord * fbRes);                      \n"
+    "        c.r = ditherChannel(c.r, ditherLvls.r, t);                 \n"
+    "        c.g = ditherChannel(c.g, ditherLvls.g, t);                 \n"
+    "        c.b = ditherChannel(c.b, ditherLvls.b, t);                 \n"
+    "    }                                                              \n"
+    "                                                                   \n"
+    "    // SGI 2.4 gamma decoded for a modern 2.2 display (after      \n"
+    "    // dithering, matching CRT physics); gammaPow 1.0 = off        \n"
+    "    c = pow(c, vec3(gammaPow));                                    \n"
+    "                                                                   \n"
+    "    gl_FragColor = vec4(c, 1.0);                                   \n"
     "}                                                                  \n";
 
