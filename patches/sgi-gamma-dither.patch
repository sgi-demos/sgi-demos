+// the NEAREST sampling, at any display density. Gamma maps SGI's 2.4 to
+// modern 2.2 displays; dithering reproduces the REX3 4x4 Bayer hardware at
+// selectable bit depths. All display-only: rasterizer output and PPM dumps
+// are untouched.
 //
 // Config (native env / web URL param):
 //   SGI_PAR=0|1      / ?par=0|1        pixel aspect correction (default 1)
+//   SGI_GAMMA=0|1    / ?gamma=0|1      gamma 2.4 -> 2.2       (default 1)
+//   SGI_DITHER=0..4  / ?dither=0..4    0 off (default), 1 Indy 8-bit XL
+//                                      (3-3-2), 2 Indigo2 12-bit (4-4-4),
+//                                      3 15-bit (5-5-5), 4 16-bit (5-6-5)
 //
 #define SGI_PAR_NUM 15  // displayed width = fb columns * 16/15
 #define SGI_PAR_DEN 16
 
 static bool parEnabled = true;
+static bool gammaEnabled = true;
+static int  ditherMode = 0;
+static const float ditherLevels[5][3] = {
+    { 256, 256, 256 },  // 0: off (unused)
+    {   8,   8,   4 },  // 1: SGI Indy 8-bit XL (3-3-2)
+    {  16,  16,  16 },  // 2: Indigo2 12-bit (4-4-4)
+    {  32,  32,  32 },  // 3: generic 15-bit (5-5-5)
+    {  32,  64,  32 },  // 4: PC 16-bit HighColor (5-6-5)
+};
 
